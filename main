#!/bin/bash

set -e

project=$(jq -r .project config.json)
sessionid=$(jq -r .sessionid config.json)

#the user's token reaches bl through the environment (BL_TOKEN); it is not written to disk
#(exported before set -x so it is not printed)
export SINGULARITYENV_BL_TOKEN=$(jq -r .jwt config.json)

#for debugging
if [ ! -z $BLHOST ]; then
    #debug
    export EZBIDS="${EZBIDS:-/mnt/ezbids/workdir}"
else
    #production
    BLHOST=brainlife.io
fi

set -x

root=$EZBIDS/$sessionid/bids
if [ ! -f $root/dataset_description.json ]; then
    root=$root/$(ls -rt $root | tail -1)
    echo "using subdirectory on $root"
fi

#bl bids upload from pybrainlife (the Python CLI; the Node CLI image brainlife/cli is no longer used).
#pybrainlife is pip-installed into this task's folder on each run: pin it with PYBRAINLIFE_REF
#(a tag, branch or commit of github.com/brainlife/pybrainlife)
BL_SINGULARITY_PYTHON_IMAGE="${BL_SINGULARITY_PYTHON_IMAGE:-docker://python:3.11-slim}"
PYBRAINLIFE_REF="${PYBRAINLIFE_REF:-master}"

singularity exec -e \
  -B $EZBIDS \
  -B `pwd`:/task \
  $BL_SINGULARITY_PYTHON_IMAGE bash -c '
    set -e
    pip install --quiet --disable-pip-version-check --no-cache-dir --target /task/pybrainlife \
        "https://github.com/brainlife/pybrainlife/archive/$0.zip"
    PYTHONPATH=/task/pybrainlife python -c "import sys; sys.argv[0] = \"bl\"; from brainlife.cli.__main__ import main; main()" \
        -H "$1" bids upload -p "$2" "$3"
  ' "$PYBRAINLIFE_REF" "$BLHOST" "$project" "$root"
